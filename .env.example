# Caught in 4K Environment Configuration

# === AI API Configuration ===
# Pollinations.AI is the PRIMARY AI provider (free, no signup, no API key required)
# Canon Takes and Satisfaction Meter one-liners are generated via Pollinations.AI
# No configuration needed — it works out of the box!

# Canon Takes API Proxy URL (OPTIONAL — Gemini proxy fallback)
# Only needed if Pollinations.AI is unavailable
# This is the backend proxy that calls Gemini API
# Set this to the URL where you deploy the api-proxy-template.js
# Examples:
#   - Local development: http://localhost:3001/api/canon-take
#   - Vercel: https://your-project.vercel.app/api/canon-take
#   - Netlify: https://your-project.netlify.app/.netlify/functions/canon-take
REACT_APP_CANON_PROXY_URL=

# Privacy-friendly analytics (optional). Example: c4k.live
REACT_APP_PLAUSIBLE_DOMAIN=

# General API base for billing/admin endpoints when the frontend is deployed statically
# Example: https://api.c4k.live
REACT_APP_API_BASE_URL=

# === Invite-only access (production) ===
# Comma-separated list of valid keys. Each key is exactly 12 letters or digits (case-insensitive).
# You can write them with or without dashes, e.g. ABCD1234EFGH or ABCD-1234-EFGH
# Leave empty to disable the gate (recommended for local development).
C4K_ACCESS_KEYS=

# === Supabase Configuration (for C4K auth & subscriptions) ===
# Get these from https://app.supabase.com → Project Settings → API
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# === Stripe Configuration (for subscriptions) ===
# Get the publishable key from https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# === Backend-only keys (used in api-proxy.js, NOT in frontend) ===
# Public app URL for Stripe success/cancel redirects and backend CORS allowlisting
# This can include a subpath if the frontend is not served from /.
# Examples: https://c4k.live or https://c4k.live/app
APP_BASE_URL=
# Optional comma-separated extra allowed frontend origins
# Example: https://preview.c4k.live,https://staging.c4k.live
ALLOWED_APP_ORIGINS=
# Stripe secret key — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe webhook signing secret — https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# Supabase service role key (admin access) — Project Settings → API → service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: LLM API keys are stored on the backend only (api-proxy.js / api-proxy-template.js)
# Canon Take proxy tries Gemini, then Groq, then OpenRouter when configured.
# Do NOT expose any API keys in the frontend code
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# === C4K Stremio add-on (backend only) ===
# Standalone add-on HTTP port. The default is 7000.
C4K_ADDON_PORT=7000
# Public HTTPS base used in stream URLs returned to Stremio.
# Production example: https://addon.c4k.live
C4K_ADDON_PUBLIC_URL=
# Source provider: index, jellyfin, or plex. Defaults to index for backwards compatibility.
C4K_SOURCE_PROVIDER=index
# Ranking profile: absolute, imax, or 3d.
C4K_QUALITY_PROFILE=absolute
# Maximum ranked streams returned to Stremio. Valid range: 1-10.
C4K_MAX_STREAMS=5

# Generic authorised source-index provider (C4K_SOURCE_PROVIDER=index)
C4K_SOURCE_INDEX_URL=
# Exact comma-separated hostnames that candidate direct-media URLs are allowed to use.
# Example: media.example.com,cdn.example.com
C4K_ALLOWED_MEDIA_HOSTS=
# Optional bearer token sent only from the add-on server to the authorised source index.
C4K_SOURCE_INDEX_TOKEN=
# Source-index request timeout in milliseconds.
C4K_SOURCE_TIMEOUT_MS=8000

# Jellyfin provider (C4K_SOURCE_PROVIDER=jellyfin)
# Jellyfin server base URL. HTTPS is required in production; localhost HTTP is allowed in development.
C4K_JELLYFIN_URL=
# Jellyfin access token. Backend only. It is never returned in Stremio stream URLs.
C4K_JELLYFIN_TOKEN=
# Optional Jellyfin user id used to scope visible library items and playback info.
C4K_JELLYFIN_USER_ID=
# Library IMDb-index cache duration in milliseconds. Default: 300000 (5 minutes).
C4K_JELLYFIN_CACHE_MS=300000
# Page size used while indexing movies by IMDb id. Default: 200, maximum: 500.
C4K_JELLYFIN_PAGE_SIZE=200
# Maximum number of Jellyfin movie items scanned into the in-memory IMDb index.
C4K_JELLYFIN_SCAN_MAX_ITEMS=20000
# Jellyfin metadata request timeout in milliseconds.
C4K_JELLYFIN_TIMEOUT_MS=8000

# Plex provider (C4K_SOURCE_PROVIDER=plex)
# Plex Media Server base URL. HTTPS is required in production; localhost HTTP is allowed in development.
C4K_PLEX_URL=
# Plex access token. Backend only. It is never returned in Stremio stream URLs.
C4K_PLEX_TOKEN=
# Stable client identifier sent to Plex. Change only if you intentionally need another identifier.
C4K_PLEX_CLIENT_ID=c4k-stremio-addon
# Library IMDb-index cache duration in milliseconds. Default: 300000 (5 minutes).
C4K_PLEX_CACHE_MS=300000
# Page size used while indexing Plex movies. Default: 200, maximum: 500.
C4K_PLEX_PAGE_SIZE=200
# Maximum number of Plex movie items scanned into the in-memory IMDb index.
C4K_PLEX_SCAN_MAX_ITEMS=20000
# Plex metadata request timeout in milliseconds.
C4K_PLEX_TIMEOUT_MS=8000

# Shared media relay settings for Jellyfin and Plex.
# HMAC secret used to sign short-lived C4K media relay URLs. Use a long random value.
C4K_MEDIA_RELAY_SECRET=
# Relay URL lifetime in seconds. Default: 21600 (6 hours), maximum: 86400 (24 hours).
C4K_MEDIA_RELAY_TTL_SECONDS=21600

# ── Token Optimization (Headroom + RTK + MemStack) ──
# Set ANTHROPIC_BASE_URL to route Claude Code through Headroom proxy for ~34% token savings
# Only set this when Headroom is running: `headroom proxy --port 8787`
# Start automatically with: scripts/setup/start-claude.bat (Windows) or start-claude.sh (Unix)
ANTHROPIC_BASE_URL=http://127.0.0.1:8787
# RTK telemetry opt-out (already set in .claude/settings.json; include here for shell sessions)
RTK_TELEMETRY_DISABLED=1

# ── Claude Organize (AI-powered file organization via Claude Code hooks) ──
# Set BYPASS=true to temporarily disable auto-organization
CLAUDE_ORGANIZE_BYPASS=false
CLAUDE_ORGANIZE_DEBUG=false
# Comma-separated glob patterns of files that should NEVER be moved
CLAUDE_ORGANIZE_SKIP_PATTERNS=*.config.js,*.config.mjs,webpack.config.js,api-proxy.js,api-proxy-template.js,http_server.js,generate-icons.js,setup.bat,setup.sh,DESIGN.md,CANON_TAKES_SETUP.md,QUICK_START.md,READY_CHECKLIST.md,organizing.md,CHANGELOG.md,CODE_OF_CONDUCT.md,LICENSE,LICENSE.md,Dockerfile,README.md
# JavaScript file organization (EXPERIMENTAL - leave false)
CLAUDE_ORGANIZE_JS=false
CLAUDE_ORGANIZE_JS_MODE=safe
